{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raptor LLM",
  "version": "0.1.9",
  "identifier": "dev.raptorllm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Raptor LLM",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "decorations": true,
        "backgroundColor": "#090b10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://huggingface.co https://*.huggingface.co; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/runtime-manifest.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQzBCMUExMzBEMjUyNTcKUldSWFV0SXdvYkhBN1c2YkVVb0RrcmNhVVdoOHJ2eG1GcFdQc1g0a1hIMTNNMm1SeFVJT0pwRW0K",
      "endpoints": [
        "https://github.com/pwoodman/RaptorLLM/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
